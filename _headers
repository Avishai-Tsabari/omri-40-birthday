# Cloudflare Pages headers.
#
# ⚠️ Cloudflare *ממזג* כללים חופפים במקום שהספציפי יגבר. כלל /* עם
# no-cache הדביק no-cache גם לסרטונים, וזה מנע מהקצה לשמור אותם —
# ומכאן שהוא החזיר 200 עם כל הקובץ במקום 206 Partial Content.
# לכן אין כאן /* בכלל, אלא כללים שלא חופפים.

# רק ה-HTML צריך אימות מחדש: הוא מחזיק את מספרי הגרסה (?v=N).
# ה-JS וה-CSS ממילא מבוטלי-מטמון דרך אותם מספרים.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# הסרטונים: עומרי על אייפון, וכל דפדפן ב-iOS הוא WebKit — כולל Chrome.
# WebKit דורש 206 על Range requests כדי לנגן וידאו בכלל, ו-Cloudflare
# מחזיר 206 רק כשהקובץ נשמר בקצה. חמש דקות מספיק קצר להחלפת סרטון.
/videos/*
  Cache-Control: public, max-age=300

/audio/*
  Cache-Control: public, max-age=300
