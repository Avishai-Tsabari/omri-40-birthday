# Cloudflare Pages headers.

# ברירת מחדל: no-cache. לא "אל תשמור" אלא "תמיד תוודא מול השרת".
# index.html מחזיק את מספרי הגרסה (?v=N) של ה-CSS וה-JS — אם הוא נתפס
# במטמון, העלאת הגרסה לא מגיעה לטלפון והוא ממשיך להריץ קוד ישן.
/*
  Cache-Control: no-cache

# הסרטונים הם חריג, ומסיבה קונקרטית: עומרי על אייפון.
# WebKit — וכל דפדפן ב-iOS הוא WebKit, גם Chrome — דורש שהשרת יענה
# על Range requests ב-206 Partial Content כדי לנגן וידאו בכלל.
# תחת no-cache, Cloudflare לא שומר את הקובץ בקצה והחזיר 200 עם כל
# הקובץ, בלי accept-ranges. max-age חיובי מחזיר את ה-206.
# חמש דקות זה מספיק קצר כדי שהחלפת סרטון תגיע מהר.
/videos/*
  Cache-Control: public, max-age=300
